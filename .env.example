# =============================================================================
# ChatBB — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou cadastre no EasyPanel (produção).
# NUNCA versione o arquivo .env real. Nenhuma variável abaixo usa NEXT_PUBLIC_
# para segredos; todas são lidas em TEMPO DE EXECUÇÃO no servidor, então o mesmo
# build/imagem Docker serve para qualquer ambiente (sem build args).
# =============================================================================

# ---------- PRIVADAS (segredos / operação) — obrigatórias ----------------------

# URL de PRODUÇÃO do webhook do n8n (termina em /webhook/chatbb-rsvp).
# NÃO use a URL de teste (/webhook-test/...). Se o n8n estiver na mesma rede do
# EasyPanel, pode usar a URL interna (ex.: http://n8n:5678/webhook/chatbb-rsvp).
N8N_WEBHOOK_URL=

# Segredo compartilhado (mín. 16 caracteres; sugestão: `openssl rand -hex 32`).
# Deve ser IDÊNTICO ao valor da credencial "Header Auth" do webhook no n8n.
N8N_WEBHOOK_SECRET=

# ---------- PRIVADAS — opcionais -----------------------------------------------

# Nome do cabeçalho que carrega o segredo (igual ao "Name" da credencial Header Auth).
# N8N_WEBHOOK_SECRET_HEADER=X-ChatBB-Secret

# Tempo máximo de espera pelo n8n (ms). Padrão 15000.
# N8N_TIMEOUT_MS=15000

# Rate limiting (por processo; veja README sobre múltiplas réplicas).
# RATE_LIMIT_MAX=10                    # requisições por IP na janela
# RATE_LIMIT_WINDOW_SECONDS=600        # janela por IP
# RATE_LIMIT_GLOBAL_PER_MINUTE=60      # teto total por minuto

# Quantos proxies confiáveis existem à frente do app (EasyPanel/Traefik = 1).
# TRUSTED_PROXY_HOPS=1

# Máx. de envios aguardando a vez para o n8n antes de responder 503.
# MAX_QUEUED_SUBMISSIONS=30

# ---------- CONFIGURAÇÃO DO EVENTO (não são segredos) --------------------------

# Fuso do evento (usado para exibir data/hora).
EVENT_TIMEZONE=America/Fortaleza

# Início do evento — ISO 8601 COM fuso. Base da contagem regressiva.
EVENT_DATE=2026-11-22T08:00:00-03:00

# PREENCHER: prazo final para confirmar (ISO 8601 com fuso), ex.: 2026-11-15T23:59:59-03:00
# Vazio = as confirmações fecham no início do evento.
RSVP_DEADLINE=

# PREENCHER: endereço completo do local (aparece na seção Informações/Localização
# e melhora a busca no mapa). Vazio = o mapa busca pelo nome do local + cidade.
EVENT_ADDRESS=

# PREENCHER: link do botão "Como chegar" (ex.: link de compartilhamento do Google Maps).
# Vazio = busca no Google Maps pelo endereço/nome do local.
EVENT_MAP_URL=

# Opcional: URL de incorporação do mapa (Google Maps > Compartilhar > Incorporar > src).
# Precisa ser https://www.google.com/maps/... (a CSP só permite google.com). Vazio = automático.
EVENT_MAP_EMBED_URL=

# URL pública do site (https://seu-dominio.com). Usada em metadados (Open Graph) e
# na verificação de Origin da API. Lida em tempo de execução.
NEXT_PUBLIC_SITE_URL=

# Limites de convidados por resposta (titular incluído em "adultos").
RSVP_MAX_ADULTS=10
RSVP_MAX_CHILDREN=10

# true = permite que o titular seja uma criança (adultos = 0, crianças >= 1).
# Se mudar aqui, mude também ALLOW_CHILD_HOLDER no nó "Validar e normalizar" do n8n.
RSVP_ALLOW_CHILD_HOLDER=false

# ---------- Servidor ------------------------------------------------------------
PORT=3000
